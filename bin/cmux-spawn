#!/bin/bash
# cmux-spawn — spawn a cmux workspace that ALWAYS works.
#
# Route 1 (socket): `cmux new-workspace` — full features (name, description).
# Route 2 (AppleScript, fallback): sdef `new tab` + `input text` — needs NO
#   socket. cmux-updates kill the socket server permanently (restarts do NOT
#   rebind it, verified 2026-07-17), so this path is the reliable default on
#   a broken socket. cmux auto-titles the tab from content; --name is
#   best-effort only there.
#
# usage: cmux-spawn [--cwd DIR] [--command CMD] [--name NAME]
#                   [--description TEXT] [--focus true|false] [--via socket|applescript|auto]
set -u

CWD="$PWD"; CMD=""; NAME=""; DESC=""; FOCUS="false"; VIA="auto"
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) CWD="$2"; shift 2;;
    --command) CMD="$2"; shift 2;;
    --name) NAME="$2"; shift 2;;
    --description) DESC="$2"; shift 2;;
    --focus) FOCUS="$2"; shift 2;;
    --via) VIA="$2"; shift 2;;
    -h|--help) sed -n '2,14p' "$0"; exit 0;;
    *) echo "cmux-spawn: unknown arg $1" >&2; exit 2;;
  esac
done

socket_alive() { cmux ping >/dev/null 2>&1; }

spawn_socket() {
  cmux new-workspace ${NAME:+--name "$NAME"} ${DESC:+--description "$DESC"} \
       --cwd "$CWD" ${CMD:+--command "$CMD"} --focus "$FOCUS" >/dev/null 2>&1
}

spawn_applescript() {
  # command + cwd go in via env — avoids every AppleScript quoting pitfall.
  # `input text` QUEUES into the terminal even while the shell is still
  # booting and executes once it's up (verified 2026-07-17) — so we send
  # exactly ONCE and never resend (a resend double-executes; for
  # `claude --resume` the 2nd instance dies on the session-lock).
  # The verify loop only reports status (wd/title change = shell reacted).
  CSPAWN_CMD="$CMD" CSPAWN_CWD="$CWD" CSPAWN_FOCUS="$FOCUS" osascript - <<'EOF'
on reacted(t, wd0, nm0)
  tell application "cmux"
    try
      set term to focused terminal of t
      if (working directory of term) is not wd0 then return true
      if (name of t) is not nm0 then return true
    end try
  end tell
  return false
end reacted

tell application "cmux"
  set t to new tab
  delay 1
  set cmd to system attribute "CSPAWN_CMD"
  set wd to system attribute "CSPAWN_CWD"
  set cmdline to "cd " & quoted form of wd
  if cmd is not "" then set cmdline to cmdline & " && " & cmd
  set term to focused terminal of t
  set wd0 to working directory of term
  set nm0 to name of t
  input text (cmdline & linefeed) to term
  if (system attribute "CSPAWN_FOCUS") is "true" then select tab t
end tell
set ok to false
repeat 20 times
  delay 1
  if my reacted(t, wd0, nm0) then
    set ok to true
    exit repeat
  end if
end repeat
tell application "cmux"
  return "tab:" & (index of t) & (item ((ok as integer) + 1) of {" (queued — shell still booting)", ""})
end tell
EOF
}

case "$VIA" in
  socket) spawn_socket;;
  applescript) spawn_applescript;;
  auto)
    if socket_alive; then spawn_socket || spawn_applescript
    else spawn_applescript; fi;;
  *) echo "cmux-spawn: --via must be socket|applescript|auto" >&2; exit 2;;
esac
