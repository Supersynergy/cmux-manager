#!/bin/bash
# cmuxman — cmux fleet manager.
# Safe app updates with session preservation, fleet status, duplicate cleanup,
# and meta-orchestration of Claude sessions (send/tail/spawn/council).
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
BIN_DIR="$(cd "$(dirname "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")")" && pwd)"
VERSION=0.2.0
REPO="${CMUX_REPO:-manaflow-ai/cmux}"
APP="${CMUX_APP:-/Applications/cmux.app}"
VAULT="${CMUX_VAULT:-$HOME/projects/cmux-vault}"
WORKER="$BIN_DIR/cmuxman-update-worker"
LABEL=com.cmux.manager.update

usage() {
  cat <<'EOF'
cmuxman — cmux fleet manager

Fleet (status/goals backed by agentmaster when installed):
  status                     ground-truth table: agentmaster ls (Needs input/
                             working/ready) or cmux-dot fallback
  brief [days]               one-shot state-of-everything: real commits +
                             fleet status + limit-scan (repeatable /checkin)
  tail <ws> [n]              last n lines (default 40) of workspace <ws>
  send <ws> <text> [--force] type text+Enter into a workspace (busy-guarded)
  spawn --cwd D --command C  new workspace (socket, AppleScript fallback)
  dedupe [--apply]           find duplicate-title workspaces; --apply closes idle twins
  goal <name> <text>         pin a goal (passthrough to agentmaster)
  goals                      list all pinned goals + progress
  triage <ws>                evidence + ready metaflow kill/continue prompt for a stale session
  council <question> [-e a,b,c]  fan question out to engine pool, print all answers

Limit auto-resume, autonomous optimize & remote:
  limit-scan                 show sessions blocked/near the 5h usage limit
  resume-fleet [--now|--at HH:MM]  schedule (or run) auto-continue of
                             limit-blocked sessions after the limit resets
  optimize start [every-min] recurring bounded loop: auto-nudges limit-blocked
                             sessions + auto-closes idle duplicates, rate-capped
                             + fully logged (see optimize status). Default 20m.
  optimize stop              kill-switch: stop the loop immediately
  optimize status            ledger tail + today's action count + backoffs
  optimize cycle             run one decision cycle now (used by the timer)
  remote-install             set up phone remote control via ntfy.sh topic
  remote-serve               run the remote command listener (foreground)

Update & recovery:
  update [--force]           check release, download+verify dmg, update app,
                             restore all sessions, verify, notify
  verify                     session counts + missing-vs-manifest + dupe check
  restore-missing            targeted re-spawn of manifest sessions not running
  rescue [...]               tier-0 failsafe restore from ~/.claude/projects
  snapshot [name]            save named snapshot copy to vault (+git commit)
  doctor                     environment health checks
EOF
}

busy() {  # workspace actively running a turn?
  CMUX_QUIET=1 cmux read-screen --workspace "$1" --lines 15 2>/dev/null | grep -qi 'esc to interrupt'
}
ref() { case "$1" in workspace:*) echo "$1";; *) echo "workspace:$1";; esac; }

cmd="${1:-help}"; shift || true
case "$cmd" in

status)
  # Ground truth, in priority order:
  #   1. agentmaster ls --json  — reads real transcript/session state
  #      ("Needs input"/"working"/"ready"/idle), not a screen-text guess.
  #   2. cmux's own dot (workspace list) as fallback if agentmaster is absent.
  # A prior version of this command scanned terminal text itself and both
  # misread and hid real activity (a green/active workspace showed as generic
  # IDLE) — never recompute status by guessing when a ground-truth source exists.
  if command -v agentmaster >/dev/null 2>&1; then
    python3 - <<'PY'
import subprocess, json, os
env={**os.environ,'CMUX_QUIET':'1'}
r=subprocess.run(['agentmaster','ls','--json'],capture_output=True,text=True,env=env,timeout=20)
rows=json.loads(r.stdout) if r.returncode==0 and r.stdout.strip() else []
me=os.environ.get('CMUX_WORKSPACE_ID','')
for row in rows:
    ref=row.get('ref','?'); status=row.get('status','?'); glyph=row.get('glyph','?')
    title=row.get('title','').strip()
    mark='*' if str(row.get('pid',''))==me else ' '
    print(f"{mark}{ref:<14} {glyph} {status:<12} {title[:65]}")
PY
  else
    python3 - <<'PY'
import subprocess, os, re, time
env={**os.environ,'CMUX_QUIET':'1'}
lst=subprocess.run(['cmux','workspace','list'],capture_output=True,text=True,env=env).stdout
rows=re.findall(r'(\*?)\s*workspace:(\d+)\s+(.*)',lst)
DOT_ACTIVE = {'🟢','🟡','🟠'}
for sel,wid,title in rows:
    title=title.strip()
    m = re.match(r'([🟢🟡🟠⚫🔴⚪])\s*(.*)', title)
    dot, rest = (m.group(1), m.group(2)) if m else ('—', title)
    cmux_state = 'ACTIVE' if dot in DOT_ACTIVE else 'idle  '
    mark='*' if sel else ' '
    print(f"{mark}ws:{wid:>3} {dot} {cmux_state:<12} {rest[:60]}")
    time.sleep(0.05)
PY
    echo "(no agentmaster on PATH — using weaker cmux-dot fallback; install agentmaster for real status)"
  fi
  ;;

brief)
  # Repeatable version of a manual /checkin: real commits (not mtime-touch) +
  # agentmaster fleet ground-truth + limit-scan, so "what's the state of
  # everything" is one command instead of re-deriving it by hand each time.
  WINDOW="${1:-5}"
  echo "== recent real work (git commits, not touched-but-unchanged dirs) =="
  bash "$HOME/.claude/skills/checkin/scripts/recon.sh" "$WINDOW" 2>/dev/null \
    | awk '/^## ACTIVE/{p=1} /^## MTIME/{p=0} p' | head -80
  echo; echo "== fleet ground truth (agentmaster) =="
  "$0" status
  echo; echo "== usage-limit scan =="
  "$0" limit-scan
  echo
  echo "next: pick 1-2 stale/zero-commit workspaces above and run"
  echo "  cmuxman triage <ws>   # gather evidence + a ready metaflow prompt"
  ;;

tail)
  [ $# -ge 1 ] || { echo "usage: cmuxman tail <ws> [lines]"; exit 1; }
  CMUX_QUIET=1 cmux read-screen --workspace "$(ref "$1")" --lines "${2:-40}"
  ;;

send)
  [ $# -ge 2 ] || { echo "usage: cmuxman send <ws> <text> [--force]"; exit 1; }
  WS="$(ref "$1")"; TEXT="$2"; FORCE="${3:-}"
  if [ "$FORCE" != "--force" ]; then
    if busy "$WS"; then echo "REFUSED: $WS is mid-turn (use --force to interrupt its input)"; exit 2; fi
    SCREEN=$(CMUX_QUIET=1 cmux read-screen --workspace "$WS" --lines 10 2>/dev/null)
    [ -z "$SCREEN" ] && { echo "REFUSED: $WS screen empty (booting shell queues input — retry when ready or --force)"; exit 2; }
  fi
  CMUX_QUIET=1 cmux send --workspace "$WS" -- "$TEXT\r" && echo "sent to $WS"
  ;;

spawn)  exec "$BIN_DIR/cmux-spawn" "$@" ;;
rescue) exec "$BIN_DIR/cmux-rescue" "$@" ;;

goal)
  command -v agentmaster >/dev/null || { echo "needs agentmaster on PATH (pin a goal on a fleet agent)"; exit 1; }
  exec agentmaster goal "$@"
  ;;
goals)
  command -v agentmaster >/dev/null || { echo "needs agentmaster on PATH"; exit 1; }
  exec agentmaster goals "$@"
  ;;

triage)
  # A stale/ambiguous workspace isn't a status question ("what does it say")
  # but a kill-or-continue decision. cmuxman has no LLM budget of its own —
  # it gathers the evidence and hands you a ready-to-paste metaflow prompt
  # instead of guessing.
  [ $# -ge 1 ] || { echo "usage: cmuxman triage <ws>"; exit 1; }
  WS="$(ref "$1")"
  TITLE=$(CMUX_QUIET=1 cmux workspace list 2>/dev/null | grep "$WS " | sed 's/^[^c]*cc/cc/')
  echo "== $WS — $TITLE =="
  echo "-- last screen --"
  CMUX_QUIET=1 cmux read-screen --workspace "$WS" --lines 20
  if command -v agentmaster >/dev/null 2>&1; then
    echo "-- agentmaster peek (last user/assistant/next, zero-tax) --"
    agentmaster peek "$WS" 2>/dev/null || echo "(no transcript found)"
  fi
  echo
  echo "-- ready-to-run metaflow prompt --"
  cat <<PROMPT
metaflow "Diese cmux-Session ($WS: ${TITLE:-unbekannt}) hat keine echten Commits in den letzten 5 Tagen. Recherchiere kurz (Quellen), ob das Thema noch einen validen Use-Case/Markt hat oder ob es geschlossen werden sollte. Gib ein klares kill/weiter mit 72h-Testregel falls weiter."
PROMPT
  ;;

dedupe)
  APPLY="${1:-}"
  python3 - "$APPLY" <<'PY'
import subprocess, os, re, sys, time
apply = len(sys.argv)>1 and sys.argv[1]=='--apply'
env={**os.environ,'CMUX_QUIET':'1'}
lst=subprocess.run(['cmux','workspace','list'],capture_output=True,text=True,env=env).stdout
rows=re.findall(r'(\*?)\s*workspace:(\d+)\s+(.*)',lst)
def norm(t): return re.sub(r'[^\w\s·…-]','',t).strip()
def busy(wid):
    r=subprocess.run(['cmux','read-screen','--workspace',f'workspace:{wid}','--lines','15'],
                     capture_output=True,text=True,env=env,timeout=15)
    return 'esc to interrupt' in r.stdout.lower()
groups={}
for sel,wid,title in rows:
    groups.setdefault(norm(title),[]).append((sel=='*',int(wid)))
plan=[]
me=os.environ.get('CMUX_WORKSPACE_ID','')
for title,members in groups.items():
    if len(members)<2: continue
    # keep priority: selected > busy > lowest id; close the rest if idle
    keep=None
    for sel,wid in members:
        if sel: keep=wid; break
    if keep is None:
        busies=[wid for _,wid in members if busy(wid)]
        keep=busies[0] if busies else min(w for _,w in members)
    for sel,wid in members:
        if wid!=keep: plan.append((wid,title))
if not plan:
    print("no duplicate-title workspaces"); sys.exit(0)
for wid,title in plan:
    if apply:
        if busy(wid): print(f"ws:{wid} SKIP (busy) — {title[:50]}"); continue
        r=subprocess.run(['cmux','workspace','close',f'workspace:{wid}'],capture_output=True,text=True,env=env)
        print(f"ws:{wid} {'closed' if r.returncode==0 else 'ERR: '+r.stderr.strip()[:40]} — {title[:50]}")
        time.sleep(0.3)
    else:
        print(f"would close ws:{wid} — {title[:50]}")
if not apply: print("\nrun `cmuxman dedupe --apply` to close these")
PY
  ;;

council)
  [ $# -ge 1 ] || { echo "usage: cmuxman council <question> [-e engine1,engine2,...]"; exit 1; }
  command -v ca >/dev/null || { echo "needs `ca` (callagent) on PATH"; exit 1; }
  Q="$1"; shift || true
  ENGINES="codex,gemini,kimi"
  [ "${1:-}" = "-e" ] && ENGINES="$2"
  STAMP=$$
  IFS=',' read -ra ENG <<<"$ENGINES"
  for e in "${ENG[@]}"; do
    ca spawn --name "council-$STAMP-$e" --prompt "$Q" -e "$e" >/dev/null 2>&1 \
      && echo "spawned: $e" || echo "spawn failed: $e"
  done
  for e in "${ENG[@]}"; do
    echo; echo "══ $e ══"
    ca collect --name "council-$STAMP-$e" --wait 240 2>/dev/null || echo "(no answer)"
  done
  ;;

snapshot)
  SNAP=$(ls -t "$HOME/.cmux-snapshots/"auto-*.json 2>/dev/null | head -1)
  [ -n "$SNAP" ] || { echo "no auto-snapshots in ~/.cmux-snapshots (snapshot daemon down?)"; exit 1; }
  NAME="${1:-manual-$(date +%Y%m%d-%H%M)}"
  mkdir -p "$VAULT/snapshots"
  DEST="$VAULT/snapshots/$NAME.json"
  cp "$SNAP" "$DEST" && echo "saved: $DEST"
  git -C "$VAULT" add snapshots >/dev/null 2>&1 && git -C "$VAULT" commit -qm "snapshot: $NAME" >/dev/null 2>&1 || true
  ;;

verify)          exec "$WORKER" --verify-only ;;
restore-missing) exec "$WORKER" --restore-missing ;;

update)
  LATEST=$(gh release view -R "$REPO" --json tagName -q .tagName)
  CUR=$(defaults read "$APP/Contents/Info.plist" CFBundleShortVersionString)
  if [ "v$CUR" = "$LATEST" ] && [ "${1:-}" != "--force" ]; then
    echo "cmux $CUR is already latest ($LATEST) — nothing to do (--force to reinstall)"
    exit 0
  fi
  echo "update: v$CUR -> $LATEST"
  gh release download "$LATEST" -R "$REPO" -p cmux-macos.dmg -O /tmp/cmux-macos.dmg --clobber
  hdiutil detach /tmp/cmux-dmg -quiet 2>/dev/null || true
  hdiutil attach -nobrowse -readonly -mountpoint /tmp/cmux-dmg /tmp/cmux-macos.dmg >/dev/null
  NEWV=$(defaults read /tmp/cmux-dmg/cmux.app/Contents/Info.plist CFBundleShortVersionString)
  codesign --verify --deep --strict /tmp/cmux-dmg/cmux.app
  hdiutil detach /tmp/cmux-dmg -quiet
  echo "dmg verified: v$NEWV, codesign OK"
  "$0" snapshot "pre-update-v$NEWV-$(date +%Y%m%d-%H%M)" || true
  launchctl remove "$LABEL" 2>/dev/null || true
  launchctl submit -l "$LABEL" -- /bin/bash "$WORKER"
  echo "submitted — cmux quits in ~20s, update installs, sessions auto-restore."
  echo "log: tail -f /tmp/cmuxman-update.log"
  ;;

limit-scan)
  python3 - <<'PY'
import subprocess, os, re
env={**os.environ,'CMUX_QUIET':'1'}
lst=subprocess.run(['cmux','workspace','list'],capture_output=True,text=True,env=env).stdout
found=0
for wid in re.findall(r'workspace:(\d+)',lst):
    r=subprocess.run(['cmux','read-screen','--workspace',f'workspace:{wid}','--lines','40'],
                     capture_output=True,text=True,env=env,timeout=15)
    t=r.stdout
    tail='\n'.join([l for l in t.splitlines() if l.strip()][-12:])  # stale scrollback is not a block
    hard=re.search(r'usage limit reached|limit will reset|hit your.*limit',tail,re.I)
    hud=re.search(r'Usage\s+\S+\s+(9[5-9]|100)%.*?resets in\s+([\dhm ]+)',t)
    if hard: print(f"ws:{wid} BLOCKED  {hard.group(0)[:60]}"); found+=1
    elif hud: print(f"ws:{wid} NEAR-LIMIT {hud.group(1)}% (resets in {hud.group(2).strip()})"); found+=1
if not found: print("no limit-blocked or near-limit sessions")
PY
  ;;

resume-fleet)
  MODE="${1:-}"
  LIST=/tmp/cmuxman-resume-list.txt
  RLOG=/tmp/cmuxman-resume.log
  PROMPT="${CMUXMAN_RESUME_PROMPT:-continue}"
  if [ "$MODE" = "--now" ]; then
    exec >>"$RLOG" 2>&1
    echo "== $(date '+%F %T') resume-fleet firing"
    TARGETS=$(cat "$LIST" 2>/dev/null || true)
    python3 - "$PROMPT" <<'PY'
import subprocess, os, re, sys, time
prompt=sys.argv[1]
env={**os.environ,'CMUX_QUIET':'1'}
saved=set(open('/tmp/cmuxman-resume-list.txt').read().split()) if os.path.exists('/tmp/cmuxman-resume-list.txt') else set()
lst=subprocess.run(['cmux','workspace','list'],capture_output=True,text=True,env=env).stdout
live=re.findall(r'workspace:(\d+)',lst)
for wid in live:
    r=subprocess.run(['cmux','read-screen','--workspace',f'workspace:{wid}','--lines','40'],
                     capture_output=True,text=True,env=env,timeout=15)
    t=r.stdout
    if 'esc to interrupt' in t.lower():
        print(f"ws:{wid} skip (busy)"); continue
    tail='\n'.join([l for l in t.splitlines() if l.strip()][-12:])
    hard=re.search(r'usage limit reached|limit will reset|hit your.*limit',tail,re.I)
    idle='⏵' in t or '❯' in t or 'shift+tab' in t.lower()
    if hard or (wid in saved and idle):
        s=subprocess.run(['cmux','send','--workspace',f'workspace:{wid}','--',prompt+'\\r'],
                         capture_output=True,text=True,env=env)
        print(f"ws:{wid} {'nudged' if s.returncode==0 else 'send ERR'}")
        time.sleep(1.0)
    else:
        print(f"ws:{wid} skip (no limit marker, not in saved list)")
PY
    osascript -e 'display notification "limit-blocked sessions nudged" with title "cmuxman resume-fleet"' 2>/dev/null || true
    launchctl remove com.cmux.manager.resume 2>/dev/null || true
    exit 0
  fi
  # schedule mode: record blocked/near-limit ws + compute fire delay from HUD
  SCAN=$(python3 - "$MODE" "${2:-}" <<'PY'
import subprocess, os, re, sys
env={**os.environ,'CMUX_QUIET':'1'}
me=os.environ.get('CMUX_WORKSPACE_ID','')
mode=sys.argv[1] if len(sys.argv)>1 else ''
lst=subprocess.run(['cmux','workspace','list'],capture_output=True,text=True,env=env).stdout
targets=[]; max_min=0
for wid in re.findall(r'workspace:(\d+)',lst):
    r=subprocess.run(['cmux','read-screen','--workspace',f'workspace:{wid}','--lines','40'],
                     capture_output=True,text=True,env=env,timeout=15)
    t=r.stdout
    tail='\n'.join([l for l in t.splitlines() if l.strip()][-12:])
    hard=re.search(r'usage limit reached|limit will reset|hit your.*limit',tail,re.I)
    hud=re.search(r'Usage\s+\S+\s+(9[5-9]|100)%.*?resets in\s+(?:(\d+)h\s*)?(\d+)m',t)
    if hard or hud:
        targets.append(wid)
        if hud:
            mins=(int(hud.group(2) or 0))*60+int(hud.group(3))
            max_min=max(max_min,mins)
with open('/tmp/cmuxman-resume-list.txt','w') as f: f.write('\n'.join(targets)+'\n')
delay=(max_min+3)*60 if max_min else 35*60
if mode=='--at' and len(sys.argv)>2:
    import datetime
    h,m=map(int,sys.argv[2].split(':'))
    now=datetime.datetime.now()
    tgt=now.replace(hour=h,minute=m,second=0)
    if tgt<now: tgt+=datetime.timedelta(days=1)
    delay=int((tgt-now).total_seconds())
print(f"targets: {' '.join(targets) or 'none'}")
print(f"DELAY={delay}")
PY
  )
  echo "$SCAN" | grep -v '^DELAY='
  DELAY=$(echo "$SCAN" | grep -oE 'DELAY=[0-9]+' | cut -d= -f2)
  [ -s /tmp/cmuxman-resume-list.txt ] && [ "$(head -c1 /tmp/cmuxman-resume-list.txt)" != "" ] || { echo "nothing to schedule"; exit 0; }
  # launchd can only act as TIMER here: the cmux socket denies launchd-started
  # processes, so the fire pokes the in-cmux remote listener via ntfy, which
  # executes the nudge with socket access. The job removes its own label —
  # `launchctl submit` restarts exited jobs forever otherwise.
  TOPIC_FILE="$HOME/.config/cmuxman/remote-topic"
  [ -s "$TOPIC_FILE" ] || { echo "needs the in-cmux listener: run  cmuxman remote-install  first"; exit 1; }
  pgrep -f 'cmuxman remote-serve' >/dev/null || echo "WARN: no remote-serve listener running — run cmuxman remote-install"
  TOPIC=$(cat "$TOPIC_FILE")
  launchctl remove com.cmux.manager.resume 2>/dev/null || true
  launchctl submit -l com.cmux.manager.resume -- /bin/bash -c \
    "sleep $DELAY; curl -s -d 'resume-fleet --now' https://ntfy.sh/$TOPIC >/dev/null; sleep 5; launchctl remove com.cmux.manager.resume"
  FIRE=$(date -v "+${DELAY}S" '+%H:%M' 2>/dev/null || date '+%H:%M')
  echo "scheduled: resume-fleet fires ~$FIRE (in $((DELAY/60))m via launchd timer -> ntfy -> in-cmux listener)"
  ;;

optimize)
  # Bounded recursive-learning loop, NOT unlimited autonomy: a fixed action
  # set (resume-nudge / dedupe-close), a hard rate cap per cycle and per day,
  # a full audit ledger (every action logged before/after, nothing silent),
  # and a trivial kill-switch. This is the standard bounded-agent-loop shape
  # (explicit iteration/budget cap + a metric-tied stop condition) — full
  # autonomy still means an engineered stop contract, not none at all.
  DB="$HOME/.config/cmuxman/optimize.db"
  STOPFLAG="$HOME/.config/cmuxman/optimize.stop"
  MAX_PER_CYCLE="${CMUXMAN_OPT_MAX_PER_CYCLE:-8}"
  MAX_PER_DAY="${CMUXMAN_OPT_MAX_PER_DAY:-60}"
  mkdir -p "$HOME/.config/cmuxman"
  MODE="${1:-status}"
  case "$MODE" in

  --start|start)
    EVERY="${2:-20}"
    rm -f "$STOPFLAG"
    TOPIC_FILE="$HOME/.config/cmuxman/remote-topic"
    [ -s "$TOPIC_FILE" ] || { echo "needs the in-cmux listener: run  cmuxman remote-install  first"; exit 1; }
    pgrep -f 'cmuxman remote-serve' >/dev/null || echo "WARN: no remote-serve listener running — run cmuxman remote-install"
    PLIST="$HOME/Library/LaunchAgents/com.cmux.manager.optimize.plist"
    cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.cmux.manager.optimize</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-c</string>
    <string>curl -s -d "optimize cycle" https://ntfy.sh/$(cat "$TOPIC_FILE")</string>
  </array>
  <key>StartInterval</key><integer>$((EVERY*60))</integer>
  <key>StandardOutPath</key><string>/tmp/cmuxman-optimize-timer.log</string>
  <key>StandardErrorPath</key><string>/tmp/cmuxman-optimize-timer.log</string>
</dict></plist>
EOF
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"
    echo "optimize loop started: fires every ${EVERY}m via launchd timer -> ntfy -> in-cmux listener"
    echo "cap: ${MAX_PER_CYCLE}/cycle, ${MAX_PER_DAY}/day. stop: cmuxman optimize --stop"
    ;;

  --stop|stop)
    touch "$STOPFLAG"
    launchctl unload "$HOME/Library/LaunchAgents/com.cmux.manager.optimize.plist" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.cmux.manager.optimize.plist"
    echo "optimize loop stopped (kill-switch armed, timer removed)"
    ;;

  --status|status)
    echo "kill-switch: $([ -f "$STOPFLAG" ] && echo ARMED || echo clear)"
    echo "timer: $(launchctl list 2>/dev/null | grep -q com.cmux.manager.optimize && echo loaded || echo 'not loaded')"
    [ -f "$DB" ] && python3 - "$DB" <<'PY'
import sqlite3, sys, datetime
db=sqlite3.connect(sys.argv[1])
today=datetime.date.today().isoformat()
n=db.execute("select count(*) from actions where ts like ?", (today+'%',)).fetchone()[0]
print(f"today: {n} actions")
print("last 10:")
for row in db.execute("select ts,ws,action,result from actions order by ts desc limit 10"):
    print(f"  {row[0]}  {row[1]:<14} {row[2]:<14} {row[3]}")
PY
    [ -f "$DB" ] || echo "no ledger yet (optimize --cycle has never run)"
    ;;

  --cycle|cycle)
    LOG=/tmp/cmuxman-optimize.log
    exec >>"$LOG" 2>&1
    if [ -f "$STOPFLAG" ]; then echo "$(date '+%F %T') kill-switch armed — skipping cycle"; exit 0; fi
    python3 - "$DB" "$MAX_PER_CYCLE" "$MAX_PER_DAY" <<'PY'
import subprocess, json, os, re, sys, sqlite3, datetime, time

db_path, max_cycle, max_day = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
env = {**os.environ, 'CMUX_QUIET': '1'}
now = datetime.datetime.now().isoformat(timespec='seconds')
today = now[:10]

os.makedirs(os.path.dirname(db_path), exist_ok=True)
db = sqlite3.connect(db_path)
db.execute("""create table if not exists actions(
    ts text, ws text, title text, action text, reason text, result text,
    outcome text default 'pending')""")
db.execute("""create table if not exists backoff(ws text primary key, fails int default 0, until text)""")
db.commit()

def log(msg): print(f"{now} {msg}")

day_count = db.execute("select count(*) from actions where ts like ?", (today+'%',)).fetchone()[0]
if day_count >= max_day:
    log(f"daily cap reached ({day_count}/{max_day}) — skipping cycle")
    sys.exit(0)

# 1. Check outcomes of the previous cycle's pending actions (did status change as expected?)
r = subprocess.run(['agentmaster', 'ls', '--json'], capture_output=True, text=True, env=env, timeout=20)
live = {row['ref']: row for row in json.loads(r.stdout)} if r.returncode == 0 and r.stdout.strip() else {}

pending = db.execute("select rowid,ws,action from actions where outcome='pending'").fetchall()
for rowid, ws, action in pending:
    cur = live.get(ws, {}).get('status')
    if action == 'resume-nudge':
        outcome = 'success' if cur in ('working', 'ready') else ('pending' if cur == 'Needs input' else 'unknown')
    elif action == 'dedupe-close':
        outcome = 'success' if ws not in live else 'failed'  # workspace ref gone = closed
    else:
        outcome = 'unknown'
    if outcome != 'pending':
        db.execute("update actions set outcome=? where rowid=?", (outcome, rowid))
        if outcome == 'failed':
            f = db.execute("select fails from backoff where ws=?", (ws,)).fetchone()
            fails = (f[0] if f else 0) + 1
            until = (datetime.datetime.now() + datetime.timedelta(hours=min(fails, 6))).isoformat(timespec='seconds')
            db.execute("insert into backoff(ws,fails,until) values(?,?,?) on conflict(ws) do update set fails=?,until=?",
                       (ws, fails, until, fails, until))
            log(f"outcome: {ws} {action} FAILED ({fails}x) -> backing off until {until}")
db.commit()

def backed_off(ws):
    row = db.execute("select until from backoff where ws=?", (ws,)).fetchone()
    return bool(row and row[0] > now)

# 2. Decide this cycle's actions from live fleet state (fixed action set only)
lst = subprocess.run(['cmux', 'workspace', 'list'], capture_output=True, text=True, env=env).stdout
title_of = dict(re.findall(r'(workspace:\d+)\s+(.*)', lst))

actions = []
for ref, row in live.items():
    if backed_off(ref):
        continue
    if row.get('status') == 'Needs input':
        scr = subprocess.run(['cmux', 'read-screen', '--workspace', ref, '--lines', '40'],
                             capture_output=True, text=True, env=env, timeout=15).stdout
        tail = '\n'.join([l for l in scr.splitlines() if l.strip()][-12:])
        if re.search(r'usage limit reached|limit will reset|hit your.*limit', tail, re.I):
            actions.append((ref, 'resume-nudge', 'usage-limit-blocked'))

groups = {}
def norm(t): return re.sub(r'[^\w\s·…-]', '', t).strip()
for ref, title in title_of.items():
    groups.setdefault(norm(title), []).append(ref)
for title, refs in groups.items():
    if len(refs) < 2:
        continue
    statuses = {r: live.get(r, {}).get('status') for r in refs}
    keepable = [r for r in refs if statuses.get(r) not in ('working', 'Needs input')]
    if len(keepable) < 2:
        continue
    keep = min(keepable, key=lambda r: int(r.split(':')[1]))
    for r in keepable:
        if r != keep and not backed_off(r):
            actions.append((r, 'dedupe-close', f'duplicate of {keep}'))

actions = actions[:max_cycle]
if not actions:
    log("cycle: nothing to do")
    sys.exit(0)

prompt = os.environ.get('CMUXMAN_RESUME_PROMPT', 'continue')
did = 0
for ws, action, reason in actions:
    title = title_of.get(ws, '')[:50]
    if action == 'resume-nudge':
        s = subprocess.run(['cmux', 'send', '--workspace', ws, '--', prompt + '\\r'],
                           capture_output=True, text=True, env=env)
        result = 'sent' if s.returncode == 0 else f'ERR {s.stderr.strip()[:40]}'
    elif action == 'dedupe-close':
        s = subprocess.run(['cmux', 'workspace', 'close', ws], capture_output=True, text=True, env=env)
        result = 'closed' if s.returncode == 0 else f'ERR {s.stderr.strip()[:40]}'
    else:
        result = 'skipped (unknown action)'
    db.execute("insert into actions(ts,ws,title,action,reason,result) values(?,?,?,?,?,?)",
              (now, ws, title, action, reason, result))
    log(f"{action}: {ws} ({reason}) -> {result}")
    did += 1
    time.sleep(1.0)
db.commit()

subprocess.run(['osascript', '-e',
    f'display notification "{did} action(s): see /tmp/cmuxman-optimize.log" with title "cmuxman optimize"'],
    capture_output=True)

# compounding memory: write a one-line fact so learned behavior survives across
# sessions/rebuilds instead of living only in this local sqlite ledger.
try:
    fails_today = db.execute("select count(*) from actions where ts like ? and outcome='failed'", (today+'%',)).fetchone()[0]
    fact = f"cmuxman optimize {today}: {did} actions this cycle, {fails_today} failed-today, backoffs active: " + \
           ",".join(w for w, in db.execute("select ws from backoff where until>?", (now,)).fetchall())
    subprocess.run(['bash', '-c', f'echo {json.dumps(fact)} | synx put --title "cmuxman-optimize-{today}" 2>/dev/null'],
                  timeout=10)
except Exception:
    pass
PY
    ;;

  *) echo "usage: cmuxman optimize {start [every-min]|stop|status|cycle}"; exit 1 ;;
  esac
  ;;

remote-install)
  CFG="$HOME/.config/cmuxman"; mkdir -p "$CFG"
  TOPIC_FILE="$CFG/remote-topic"
  [ -s "$TOPIC_FILE" ] || echo "cmuxman-$(openssl rand -hex 6)" >"$TOPIC_FILE"
  TOPIC=$(cat "$TOPIC_FILE")
  # retire any old launchd-based listener: launchd processes are DENIED by the
  # cmux socket ("only processes started inside cmux can connect") — the
  # listener must live in a cmux workspace.
  PLIST="$HOME/Library/LaunchAgents/com.cmux.manager.remote.plist"
  launchctl unload "$PLIST" 2>/dev/null || true; rm -f "$PLIST"
  if pgrep -f 'cmuxman remote-serve' >/dev/null; then
    echo "listener already running (inside cmux)"
  else
    "$BIN_DIR/cmux-spawn" --cwd "$HOME" --command "$BIN_DIR/cmuxman remote-serve" --focus false \
      && echo "listener spawned inside cmux"
  fi
  echo "remote control active."
  echo "  phone: install ntfy app, subscribe topic:  $TOPIC"
  echo "  send commands as messages: status | limit-scan | resume-fleet --now | dedupe | send 15 weiter"
  echo "  replies arrive on topic:   $TOPIC-r"
  ;;

remote-serve)
  TOPIC=$(cat "$HOME/.config/cmuxman/remote-topic" 2>/dev/null) || { echo "run cmuxman remote-install first"; exit 1; }
  ALLOW="status verify dedupe resume-fleet limit-scan tail send doctor snapshot version optimize brief goal goals triage"
  SINCE=$(date +%s)
  echo "remote-serve listening on ntfy.sh/$TOPIC"
  while true; do
    MSGS=$(curl -s --max-time 25 "https://ntfy.sh/$TOPIC/json?poll=1&since=$SINCE" 2>/dev/null)
    SINCE=$(date +%s)
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      MSG=$(echo "$line" | jq -r 'select(.event=="message") | .message' 2>/dev/null)
      [ -z "$MSG" ] || [ "$MSG" = null ] && continue
      set -- $MSG
      CMD="$1"
      if echo " $ALLOW " | grep -q " $CMD "; then
        echo "$(date '+%T') exec: $MSG"
        OUT=$("$BIN_DIR/cmuxman" "$@" 2>&1 | head -40)
      else
        OUT="refused: '$CMD' not in allowlist ($ALLOW)"
      fi
      curl -s -d "$OUT" "https://ntfy.sh/$TOPIC-r" >/dev/null 2>&1
    done <<<"$MSGS"
    sleep 15
  done
  ;;

doctor)
  ok() { printf '  %-34s %s\n' "$1" "$2"; }
  ok "cmux binary" "$(command -v cmux || echo MISSING)"
  ok "socket" "$(cmux ping 2>/dev/null || echo DEAD)"
  ok "app version" "$(defaults read "$APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo '?')"
  ok "snapshot daemon" "$(launchctl list 2>/dev/null | grep -q cmux-snapshot && echo loaded || echo NOT LOADED)"
  ok "auto-snapshots" "$(ls "$HOME/.cmux-snapshots/"auto-*.json 2>/dev/null | wc -l | tr -d ' ') files"
  ok "gh auth" "$(gh auth status >/dev/null 2>&1 && echo ok || echo MISSING)"
  ok "worker" "$([ -x "$WORKER" ] && echo ok || echo MISSING)"
  ok "cmux-spawn (fallback)" "$([ -x "$BIN_DIR/cmux-spawn" ] && echo ok || echo MISSING)"
  ok "ca council pool" "$(command -v ca >/dev/null && echo ok || echo 'not installed (council disabled)')"
  ok "remote listener (in cmux)" "$(pgrep -f 'cmuxman remote-serve' >/dev/null && echo running || echo 'NOT RUNNING (cmuxman remote-install)')"
  ok "agentmaster (fleet backend)" "$(command -v agentmaster >/dev/null && agentmaster --version 2>/dev/null || echo 'not installed (weaker status fallback)')"
  ok "optimize loop" "$(launchctl list 2>/dev/null | grep -q com.cmux.manager.optimize && echo 'loaded' || echo 'stopped')"
  ok "optimize kill-switch" "$([ -f "$HOME/.config/cmuxman/optimize.stop" ] && echo ARMED || echo clear)"
  ;;

version) echo "cmuxman $VERSION" ;;
help|*)  usage ;;
esac
